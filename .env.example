# Server Configuration
PORT=3000
SERVER_URL=http://localhost:3000

# Database & Cache (Supports DB_URL or DATABASEURL)
DB_URL=mongodb://localhost:27017/ecommerce
DATABASEURL=mongodb://localhost:27017/ecommerce
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
USER_SIGNATURE=your_user_jwt_secret
ADMIN_SIGNATURE=your_admin_jwt_secret
REFRESH_USER_TOKEN=your_refresh_user_token_secret
REFRESH_ADMIN_TOKEN=your_refresh_admin_token_secret
SALTROUND=10

# Cloudinary (Supports API_KEY or legacy API_KET)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Email Configuration (Nodemailer - supports GOOGLE_ACCOUNT_EMAIL or legacy GOOGLE_ACOUNCT_EMAIL)
GOOGLE_ACCOUNT_EMAIL=your_email@gmail.com
GOOGLE_APP_PASSWORD=your_google_app_password

# Stripe Payment Gateway (Card Checkout & Webhooks)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
